{
  "business_models": {
    "neo_bank": {
      "description": "Digital-only banking services with no physical branches, typically targeting younger demographics and offering streamlined mobile-first experiences.",
      "primary_metrics": ["NIM", "Cost of Funds", "Deposit Growth Rate", "NPA Ratio", "Tier 1 Capital Ratio"],
      "secondary_metrics": ["Customer Acquisition Cost", "Monthly Active Users", "Loan-to-Deposit Ratio", "Fee Income Ratio"],
      "red_flags": ["High loan loss provisions", "Regulatory actions", "Negative NIM compression", "Rapid asset quality deterioration"],
      "business_detection": {
        "keywords": ["digital bank", "neobank", "online bank", "mobile-first banking", "fintech lending", "digital lending platform"],
        "bank_revenue_weight_threshold": 0.7
      }
    },
    "pure_bank": {
      "description": "Traditional commercial or retail banking with physical branch networks, offering deposit taking, lending, and other financial services.",
      "primary_metrics": ["NIM", "Cost-to-Income Ratio", "CAR", "GNPA/NNPA", "PCR", "RoA", "RoE"],
      "secondary_metrics": ["Casa Ratio", "Deposit Growth", "Advances Growth", "Fee Income", "Operating Profit"],
      "red_flags": ["High NPAs", "Capital adequacy breach", "Regulatory penalties", "Fraud incidents", "Concentration risk"],
      "business_detection": {
        "keywords": ["commercial bank", "retail bank", "private bank", "public sector bank", "banking services", "financial institution"],
        "bank_revenue_weight_threshold": 0.8
      }
    },
    "saas": {
